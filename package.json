{
  "name": "kindle-cards",
  "version": "1.4.0-rc.1",
  "description": "Local-first Kindle highlights organizer with memo formatting and share-card export.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Muskkk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muskkkyang/kindle-cards.git"
  },
  "bugs": {
    "url": "https://github.com/muskkkyang/kindle-cards/issues"
  },
  "homepage": "https://github.com/muskkkyang/kindle-cards#readme",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "preview": "node server.mjs --prod",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test test/*.test.js",
    "test:ui": "vitest run",
    "test:watch": "vitest",
    "package:portable:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable-win.ps1",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run format:check"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "html-to-image": "^1.11.13",
    "ion-js": "^5.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
