{
  "name": "kindle-flomo-cards",
  "version": "1.0.0",
  "description": "Local-first Kindle highlights organizer with flomo formatting and share-card export.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Muskkk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muskkkyang/kindle-flomo-cards.git"
  },
  "bugs": {
    "url": "https://github.com/muskkkyang/kindle-flomo-cards/issues"
  },
  "homepage": "https://github.com/muskkkyang/kindle-flomo-cards#readme",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "preview": "node server.mjs --prod",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test test/*.test.js",
    "test:ui": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run format:check"
  },
  "dependencies": {
    "express": "^5.2.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.556.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
